<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Starting window theme for Android 12+ and backported Core SplashScreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0C1628</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fixo_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">#0C1628</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
